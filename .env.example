# Editron Server Configuration
PORT=3001
CLIENT_PORT=5173

# AI Inference Configuration (Groq / OpenAI-compatible endpoint)
# All parameters can be customized without touching any codebase files!
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Models
# Default LLM reasoning engine for timeline generation, cuts, color grading, zoom
GROQ_LLM_MODEL=gpt-oss-120b

# Default transcription model for word-level timestamps & subtitles
GROQ_WHISPER_MODEL=whisper-large-v3

# Default multimodal vision model for scene & facial expression analysis
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Storage directories
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
